        "\n",
        "# =====================================================================\n",
        "# 1. Load the Dataset\n",
        "# =====================================================================\n",
        "file_path = '/content/sample_data/california_housing_train.csv'\n",
        "real_data = pd.read_csv(file_path)\n",
        "\n",
