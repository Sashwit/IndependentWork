      "source": [
        "## 3. Pseudocode\n",
        "\n",
        "```\n",
        "BEGIN AdaBoost\n",
        "    INPUT: Training data (X, y), number of iterations T\n",
        "    \n",
        "    # Initialize sample weights\n",
        "    N = number of training samples\n",
        "    w = [1/N, 1/N, ..., 1/N]  # Equal weights initially\n",
        "    \n",
        "    models = []\n",
        "    alphas = []\n",
        "    \n",
        "    FOR t = 1 to T:\n",
        "        # Train weak classifier on weighted data\n",
        "        h_t = train_weak_classifier(X, y, weights=w)\n",
        "        \n",
        "        # Get predictions\n",
        "        predictions = h_t.predict(X)\n",
        "        \n",
        "        # Calculate weighted error\n",
        "        misclassified = (predictions != y)\n",
        "        error = sum(w[misclassified]) / sum(w)\n",
        "        \n",
        "        # If error > 0.5, stop (worse than random guessing)\n",
        "        IF error >= 0.5:\n",
        "            BREAK\n",
        "        \n",
        "        # Calculate classifier weight (importance)\n",
        "        alpha = 0.5 * log((1 - error) / error)\n",
        "        \n",
        "        # Update sample weights\n",
        "        FOR i = 1 to N:\n",
        "            IF predictions[i] != y[i]:  # Misclassified\n",
        "                w[i] = w[i] * exp(alpha)\n",
        "            ELSE:  # Correctly classified\n",
        "                w[i] = w[i] * exp(-alpha)\n",
        "        \n",
        "        # Normalize weights to sum to 1\n",
        "        w = w / sum(w)\n",
        "        \n",
        "        # Store model and its weight\n",
        "        models.append(h_t)\n",
        "        alphas.append(alpha)\n",
        "    \n",
        "    FUNCTION predict(X_new):\n",
        "        # Weighted voting\n",
        "        votes = zeros(len(X_new))\n",
        "        \n",
        "        FOR i = 1 to len(models):\n",
        "            predictions = models[i].predict(X_new)\n",
        "            votes += alphas[i] * predictions\n",
        "        \n",
        "        final_prediction = sign(votes)\n",
        "        RETURN final_prediction\n",
        "    \n",
        "    RETURN models, alphas\n",
        "END\n",
        "```"
      ]
