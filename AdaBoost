        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "\n",
        "# Generate a different synthetic dataset (Medical Insurance Premium/Risk prediction)\n",
        "np.random.seed(42)\n",
        "n_samples = 250\n",
        "\n",
        "synthetic_data = pd.DataFrame({\n",
        "    'Age': np.random.randint(18, 75, size=n_samples),\n",
        "    'BMI': np.random.uniform(15.0, 45.0, size=n_samples),\n",
        "    'SystolicBP': np.random.randint(90, 180, size=n_samples),\n",
        "    'Smoker': np.random.choice(['Yes', 'No'], size=n_samples, p=[0.2, 0.8]),\n",
        "    'Exercises': np.random.choice(['None', 'Occasional', 'Regular'], size=n_samples, p=[0.3, 0.4, 0.3]),\n",
        "    'FamilyHistory': np.random.choice([0, 1], size=n_samples, p=[0.6, 0.4]),\n",
        "    'HighRisk': np.random.choice([0, 1], size=n_samples, p=[0.75, 0.25])\n",
        "})\n",
        "\n",
        "# Save to disk as the new dataset\n",
        "synthetic_data.to_csv('Customer_Churn_Data.csv', index=False)\n",
        "\n",
        "# Load dataset\n",
        "data = pd.read_csv('Customer_Churn_Data.csv')\n",
        "\n",
        "# Encode categorical fields\n",
        "le_smoker = LabelEncoder()\n",
        "le_exercises = LabelEncoder()\n",
        "\n",
        "data['Smoker_Encoded'] = le_smoker.fit_transform(data['Smoker'])\n",
        "data['Exercises_Encoded'] = le_exercises.fit_transform(data['Exercises'])\n",
        "\n",
        "# Features\n",
        "feature_cols = ['Age', 'BMI', 'SystolicBP', 'Smoker_Encoded',\n",
        "                'Exercises_Encoded', 'FamilyHistory']\n",
        "\n",
        "X = data[feature_cols].values\n",
        "y = data['HighRisk'].values\n",
